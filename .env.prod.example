# =============================================================================
# Thesis PROD secrets — copy to gitignored `.env.prod` and paste keys.
# Never put these values in `.env` (that file is DEV only).
# Never commit `.env.prod`. Never paste keys in chat.
#
# How:  cp .env.prod.example .env.prod
# When: anytime. Port 3100 still uses `.env` / `apps/web/.env.local` (DEV).
# Agents source `.env.prod` only after you name **prod** this turn
# (SQL: also the file + CONFIRM_APPLY=1). Vercel/FastAPI deploy is Phase 10.
# =============================================================================

# Prod Supabase (https://supabase.com/dashboard/project/ndgvglcrkbygovlszxze/settings/api)
SUPABASE_URL=https://ndgvglcrkbygovlszxze.supabase.co
SUPABASE_DB_HOST=db.ndgvglcrkbygovlszxze.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_PASSWORD=

# Next.js on Vercel (P10-01). Copy these two to Vercel → Production env only.
# Never set SUPABASE_SERVICE_KEY (or any NEXT_PUBLIC_ service role) on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://ndgvglcrkbygovlszxze.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI + worker host (P10-02). Not the Vercel project.
# Native labs (D39). Paste the key for each provider you will run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
ANALYSIS_API_PORT=8091
THESIS_CORS_ORIGINS=https://eqveste.com,https://www.eqveste.com

# Porkbun DNS for eqveste.com (P10-01). Never paste values in chat.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Supabase account access token (dashboard Account → Access Tokens). Not the service role.
# Used only to PATCH prod Auth Site URL / redirect allowlist.
SUPABASE_ACCESS_TOKEN=
