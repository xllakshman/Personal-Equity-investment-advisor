# =============================================================================
# LLM (worker + analysis-api only — never NEXT_PUBLIC)
# Native labs (D39). HTTP model = model_catalog.provider_model_id.
# openai → api.openai.com · anthropic → api.anthropic.com ·
# xai → api.x.ai · deepseek → api.deepseek.com
# Missing key for the selected row’s provider → job failed / HTTP 503.
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# Market data — Yahoo chart v8 (D40 / P11-13) + SEC EDGAR headlines. No Yahoo key.
# Worker: GET query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=1y&interval=1d
# SEC wants a company name + contact email in User-Agent. A 403 becomes NOT_COVERED.
# Do not scrape stockanalysis.com. Do not set a Stock Analysis API key here.
# =============================================================================
# MARKET_DATA_USER_AGENT=

# =============================================================================
# Mail (contact form). Server-only. Never NEXT_PUBLIC.
# =============================================================================
RESEND_API_KEY=
RESEND_FROM=eqveste <onboarding@resend.dev>

