FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
RUN pip install --no-cache-dir pydantic psycopg2-binary python-dotenv httpx playwright \
 && python -m playwright install --with-deps chromium
COPY packages/python /app/packages/python
COPY apps/analysis-worker /app/apps/analysis-worker
ENV PYTHONPATH=/app/packages/python:/app/apps/analysis-worker/src
CMD ["python", "apps/analysis-worker/src/analysis_worker/main.py"]
