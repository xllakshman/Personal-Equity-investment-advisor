FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY packages/python /app/packages/python
COPY apps/analysis-api /app/apps/analysis-api
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pydantic psycopg2-binary python-dotenv httpx
ENV PYTHONPATH=/app/packages/python:/app/apps/analysis-api/src
EXPOSE 8091
CMD ["uvicorn", "analysis_api.main:app", "--host", "0.0.0.0", "--port", "8091"]
